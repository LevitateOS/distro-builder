// A module shared by the Fedora and Alpine package-effects recipes. It is kept out of
// system-files.rhai because it runs shell commands (shell_output), which would make every importer of system-files.rhai run in Ginux.

import "system-files.rhai" as system;

// What audit's scriptlet does on a new install (it seeds the rules directory
// with the package's "audit off" sample when it is empty), and what augenrules
// would then write: the concatenated /etc/audit/audit.rules.
fn audit_rules_file(root) {
    let dir = join_path(root, "etc/audit/rules.d");
    let sample = join_path(root, "usr/share/audit-rules/10-no-audit.rules");
    if !is_dir(dir) { return; }
    // The scriptlet's test (`ls` of the directory is empty): the default
    // rules go in as audit.rules, mode 0640, owned by root.
    if trim(shell_output("ls '" + dir + "'")) == "" && is_file(sample) {
        system::put(root, "etc/audit/rules.d/audit.rules", read_file(sample), 0o640);
    }
    // The *.rules files in version order (sort -V), their contents joined as
    // cat joins them, with no newline added between files.
    let names = shell_output("cd '" + dir + "' && for f in *.rules; do [ -e \"$f\" ] && printf '%s\\n' \"$f\"; done | sort -V; true");
    let text = "";
    for name in names.split("\n") {
        if name != "" { text += read_file(join_path(dir, name)); }
    }
    // The awk of augenrules: empty and comment lines are dropped, the last
    // -D (alone on its line), -b and -f go first, the last -e goes last, and
    // every other line stays in order. A line is matched after its leading
    // white space but kept whole.
    let d = "";
    let b = "";
    let f = "";
    let e = "";
    let rest = [];
    for line in text.split("\n") {
        if line.ends_with("\r") { line = line.sub_string(0, line.len() - 1); }
        if line == "" { continue; }
        let at = 0;
        while at < line.len() && " \t\x0b\x0c\r".contains(line.sub_string(at, 1)) { at += 1; }
        let head = line.sub_string(at);
        if head.starts_with("#") { continue; }
        if head.starts_with("-e") { e = line; continue; }
        if head.starts_with("-D") && trim(head.sub_string(2)) == "" { d = line; continue; }
        if head.starts_with("-f") { f = line; continue; }
        if head.starts_with("-b") { b = line; continue; }
        rest.push(line);
    }
    let out = "## This file is automatically generated from /etc/audit/rules.d\n" + d + "\n" + b + "\n" + f + "\n";
    for line in rest { out += line + "\n"; }
    out += e + "\n";
    system::put(root, "etc/audit/audit.rules", out, 0o640);
}
